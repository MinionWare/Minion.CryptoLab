<Application x:Class="Minion.CryptoLab.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Minion.CryptoLab.Wpf.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Brushes.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
                <ResourceDictionary Source="Themes/Frame.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter"/>
            <conv:FractionToWidthConverter x:Key="FractionToWidthConverter"/>
            <conv:MultilineToFontConverter x:Key="MultilineToFontConverter"/>
            <conv:HeadingDisplayTextConverter x:Key="HeadingDisplayTextConverter"/>
            <conv:IsHeadingConverter x:Key="IsHeadingConverter"/>
            <conv:UpperCaseConverter x:Key="UpperCaseConverter"/>
            <conv:PartTileBrushConverter x:Key="PartTileBrushConverter"/>
            <conv:PartToMascotConverter x:Key="PartToMascotConverter"/>
            <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <conv:NullableIntToBoolConverter x:Key="NotNullConverter"/>
            <conv:NullableIntToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
