<UserControl x:Class="Minion.CryptoLab.Wpf.Controls.CaesarWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="380"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The wheel itself: a fixed 380x380 area, nothing else shares it. -->
        <Grid Grid.Row="0">
            <!-- Outer ring: carved stone, fixed letters. -->
            <Ellipse Width="380" Height="380" Stroke="{DynamicResource Era.Stone.CarvedText}" StrokeThickness="1" Opacity=".25"/>
            <Canvas x:Name="OuterCanvas" Width="380" Height="380"/>

            <!-- Inner disc: rotates with the shift. -->
            <Ellipse Width="260" Height="260" Fill="#AAA59A" Opacity=".55"/>
            <Canvas x:Name="InnerCanvas" Width="380" Height="380" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="InnerRotate"/>
                </Canvas.RenderTransform>
            </Canvas>

            <!-- Hub. -->
            <Ellipse Width="132" Height="132" Fill="#5A5650"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="SHIFT" FontFamily="./Resources/Fonts/#Cinzel" FontSize="10" Foreground="#C9C2B4"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock x:Name="ShiftRoman" FontFamily="./Resources/Fonts/#Cinzel" FontWeight="Bold" FontSize="32"
                           Foreground="#F4EEDD" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Pointer: stone keystone at 12 o'clock. Both shapes share one 40-wide Canvas so
                 they're guaranteed to share the same centreline — centering two differently-sized
                 Polygons independently doesn't reliably line them up. -->
            <Canvas Width="40" Height="38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-8,0,0">
                <Polygon Points="0,0 40,0 28,38 12,38" Fill="#8A8578" Stroke="#5A5650" StrokeThickness="1"/>
                <Polygon Points="14,4 26,4 22,16 18,16" Fill="{DynamicResource Era.Stone.InscriptionText}"/>
            </Canvas>
        </Grid>

        <!-- Controls: a normal row below the wheel, not overlapping it. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="&#x21ba;" Width="42" Height="42" Style="{StaticResource WheelKnobButton}" Margin="0,0,14,0"
                    Command="{Binding DataContext.TurnWheelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="ccw"/>
            <TextBlock Text="TURN THE RING" VerticalAlignment="Center" FontFamily="./Resources/Fonts/#Cinzel" FontSize="10"
                       Foreground="{DynamicResource Era.Stone.CarvedText}" Margin="0,0,14,0"/>
            <Button Content="&#x21bb;" Width="42" Height="42" Style="{StaticResource WheelKnobButton}"
                    Command="{Binding DataContext.TurnWheelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="cw"/>
        </StackPanel>
    </Grid>
</UserControl>
