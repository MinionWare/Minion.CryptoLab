<UserControl x:Class="Minion.CryptoLab.Wpf.Controls.CourseProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="16" VerticalAlignment="Center">
    <Grid>
        <!-- Five fixed-weight segments (I/II/III/IV/wrap), gap 3px, radius 1px, height 6px. -->
        <Grid VerticalAlignment="Center" Height="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Era.Progress.I}" CornerRadius="1"/>
            <Border Grid.Column="2" Background="{DynamicResource Era.Progress.II}" CornerRadius="1"/>
            <Border Grid.Column="4" Background="{DynamicResource Era.Progress.III}" CornerRadius="1"/>
            <Border Grid.Column="6" Background="{DynamicResource Era.Progress.IV}" CornerRadius="1"/>
            <Border Grid.Column="8" Background="{DynamicResource Era.Progress.Wrap}" CornerRadius="1"/>
        </Grid>

        <!-- Position marker: 3x16px, top -5px relative to the 6px bar (handled by this control's own height). -->
        <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Era.Ink}"
                HorizontalAlignment="Left" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
