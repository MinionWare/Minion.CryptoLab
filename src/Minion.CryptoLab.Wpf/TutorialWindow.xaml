<Window x:Class="Minion.CryptoLab.Wpf.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Minion.CryptoLab.Wpf.ViewModels"
        xmlns:conv="clr-namespace:Minion.CryptoLab.Wpf.Converters"
        xmlns:controls="clr-namespace:Minion.CryptoLab.Wpf.Controls"
        mc:Ignorable="d"
        Title="CryptoLab" Height="860" Width="1140" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{DynamicResource Era.Background}">
    <Window.Resources>
        <conv:UpperCaseConverter x:Key="UpperCaseConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- One sidebar row: header (expanded with lessons following, or collapsed with a lesson
             count) or a lesson row, already resolved by the ViewModel into SidebarRowVm. -->
        <DataTemplate DataType="{x:Type vm:SidebarRowVm}">
            <Button Command="{Binding DataContext.JumpToLessonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding JumpStepIndex}" Cursor="Hand" Focusable="False"
                    AutomationProperties.Name="{Binding Title}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Padding="22,7" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LabelText" Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top"
                                           FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="12" Foreground="{DynamicResource Era.Faint}"/>
                                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"
                                           FontFamily="./Resources/Fonts/#IBM Plex Sans" FontSize="13" Foreground="{DynamicResource Era.Muted}"/>
                                <TextBlock x:Name="CountText" Grid.Column="2" Text="{Binding LessonCount}" VerticalAlignment="Top"
                                           FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="11" Foreground="{DynamicResource Era.Faint}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Part / wrap-up header: small caps label, title uppercase and bold-ish. -->
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="LabelText" Property="FontSize" Value="11"/>
                                <Setter TargetName="LabelText" Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
                                <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="TitleText" Property="FontSize" Value="12"/>
                                <Setter TargetName="TitleText" Property="Text" Value="{Binding Title, Converter={StaticResource UpperCaseConverter}}"/>
                                <Setter TargetName="Row" Property="Padding" Value="22,10,22,6"/>
                            </DataTrigger>
                            <!-- Current (expanded) part header: accent colour, no border-top. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHeader}" Value="True"/>
                                    <Condition Binding="{Binding IsCurrentPartHeader}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Era.AccentText}"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Era.AccentText}"/>
                            </MultiDataTrigger>
                            <!-- Collapsed (other) part header: faint, top divider, lesson count shown. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHeader}" Value="True"/>
                                    <Condition Binding="{Binding IsCurrentPartHeader}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Row" Property="BorderThickness" Value="0,1,0,0"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Era.Line}"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Era.Faint}"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Era.Faint}"/>
                                <Setter TargetName="CountText" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <!-- Active lesson (or active wrap-up row): accent left bar + tinted background. -->
                            <DataTrigger Binding="{Binding IsActiveLesson}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Era.ActiveRow}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Era.Accent}"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Era.AccentText}"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Era.Ink}"/>
                                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Era.SidebarBrush}" BorderBrush="{DynamicResource Era.Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,22,18">
                    <Image Source="{DynamicResource Era.Icon}" Width="36" Height="36" Stretch="Uniform"/>
                    <TextBlock Text="CryptoLab" Style="{StaticResource Frame.SidebarLogo}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SidebarRows}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Era.Line}" BorderThickness="0,0,0,1">
                <Grid Margin="36,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Frame.HeaderPartLabel}"
                               Text="{Binding CurrentPartInfo.Title, FallbackValue='', Converter={StaticResource UpperCaseConverter}}"/>
                    <controls:CourseProgressBar Grid.Column="1" Margin="20,0" MaxWidth="520"
                                                 LessonIndex="{Binding CurrentStepIndex}"
                                                 LessonCount="{Binding StepCount}"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Frame.HeaderStepLabel}"
                               Text="{Binding LessonPosition, StringFormat='Step {0} of 26'}"/>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Grid Grid.Row="1">
                <!-- Divider screen: shown instead of lesson content while IsDivider is true. -->
                <Grid Visibility="{Binding IsDivider, Converter={StaticResource BoolToVisibilityConverter}}" Margin="40,30,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CurrentPartInfo.Roman, StringFormat='PART {0}'}" Foreground="{DynamicResource Era.AccentText}"
                                   FontFamily="./Resources/Fonts/#IBM Plex Sans" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentPartInfo.Title}" FontFamily="{DynamicResource Era.DisplayFont}"
                                   FontWeight="Bold" FontSize="46" Foreground="{DynamicResource Era.Ink}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentPartInfo.Intro}" TextWrapping="Wrap" FontSize="16"
                                   FontFamily="./Resources/Fonts/#IBM Plex Sans" Foreground="{DynamicResource Era.Muted}" Margin="0,0,0,22"/>

                        <ItemsControl ItemsSource="{Binding DividerLessons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.JumpToLessonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding JumpStepIndex}" Cursor="Hand" Margin="0,0,10,10" Width="260">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Padding="12,10" CornerRadius="10,0,10,0" Background="{DynamicResource Era.PanelRaised}"
                                                        BorderThickness="1" BorderBrush="{DynamicResource Era.Line}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="12"
                                                                   Foreground="{DynamicResource Era.Faint}" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Era.Ink}"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Image Grid.Column="1" Source="{DynamicResource Era.Mascot}" Stretch="Uniform" VerticalAlignment="Top"
                           MaxHeight="420" Margin="20,0,0,0"/>
                </Grid>

                <!-- Wrap-up screen (Lesson 20): graffiti + ROT13 reveal, four-part recap. -->
                <Grid Visibility="{Binding IsWrapUp, Converter={StaticResource BoolToVisibilityConverter}}" Margin="40,30,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,24,0">
                        <Border CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <Image Source="pack://application:,,,/Resources/Mascots/minion-90s-paint.png" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Height="140">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#0018171C" Offset="0"/>
                                            <GradientStop Color="#E418171C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Bottom" Margin="18">
                                    <TextBlock Text="DECODE THIS" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="11" Foreground="#FFD23F"/>
                                    <TextBlock Text="LBH QVQ VG" FontFamily="./Resources/Fonts/#Bricolage Grotesque" FontWeight="Bold" FontSize="34" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LESSON 20 &#183; COURSE COMPLETE" FontFamily="./Resources/Fonts/#IBM Plex Sans" FontWeight="SemiBold"
                                   FontSize="12" Foreground="{DynamicResource Era.AccentText}"/>
                        <TextBlock Text="From stone to signatures." FontFamily="{DynamicResource Era.DisplayFont}" FontWeight="Bold" FontSize="40"
                                   Foreground="{DynamicResource Era.Ink}" Margin="0,8,0,14" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Era.Muted}" Margin="0,0,0,18">
                            <Run Text="You've worked through 2,000 years of secret-keeping: ciphers you can break by hand, the bits underneath modern encryption, how secrets are stored, and how strangers come to trust each other."/>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding RecapRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Era.Panel}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderThickness="3,0,0,0"
                                            BorderBrush="{Binding Part, Converter={StaticResource PartToRecapBrushConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Part, Converter={StaticResource PartToMascotConverter}}" Width="44" Height="44" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Era.Ink}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Info.Roman}"/><Run Text="  "/><Run Text="{Binding Info.Title}"/><Run Text=" &#183; "/><Run Text="{Binding Info.Era}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Era.Muted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding LessonRange}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="11"
                                                       Foreground="{DynamicResource Era.Faint}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <ScrollViewer Margin="40,30,40,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowLessonContent, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentStep.Title, Mode=OneWay}" FontFamily="./Resources/Fonts/#IBM Plex Sans"
                                   FontWeight="SemiBold" FontSize="20" Foreground="{DynamicResource Era.Ink}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding CurrentStep.Paragraphs, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneTime, Converter={StaticResource HeadingDisplayTextConverter}}"
                                               TextWrapping="Wrap" Margin="0,0,0,12" FontSize="14"
                                               FontFamily="{Binding Mode=OneTime, Converter={StaticResource MultilineToFontConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Era.Muted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <Binding Mode="OneTime" Converter="{StaticResource IsHeadingConverter}"/>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="FontSize" Value="16"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Era.AccentText}"/>
                                                        <Setter Property="Margin" Value="0,18,0,8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ============ Lesson 02: Caesar millstone wheel ============ -->
                        <Grid Margin="0,4,0,24" Visibility="{Binding IsCaesarLesson, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" MaxWidth="520">
                                <TextBlock Text="YOUR MESSAGE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.Faint}" Margin="0,0,0,4"/>
                                <Border Background="#11000000" BorderThickness="0" CornerRadius="6" Padding="14,12">
                                    <TextBox Text="{Binding DemoInput, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                                             FontFamily="./Resources/Fonts/#Cinzel" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Era.Ink}"/>
                                </Border>
                                <TextBlock Text="INSCRIBED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.Faint}" Margin="0,16,0,4"/>
                                <Border Background="#11000000" BorderThickness="0" CornerRadius="6" Padding="14,12">
                                    <TextBox Text="{Binding DemoOutput, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="./Resources/Fonts/#Cinzel" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource Era.Stone.InscriptionText}"/>
                                </Border>

                                <!-- Mapping strip: plain letter over its cipher letter, used ones emphasised. -->
                                <ItemsControl ItemsSource="{Binding CaesarMapping}" Margin="0,24,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="26" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding Plain}" HorizontalAlignment="Center" FontFamily="./Resources/Fonts/#Cinzel"
                                                           FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource Era.Stone.CarvedText}"
                                                           Opacity="{Binding Used, Converter={StaticResource BoolToOpacityConverter}}"/>
                                                <TextBlock Text="{Binding Cipher}" HorizontalAlignment="Center" FontFamily="./Resources/Fonts/#Cinzel"
                                                           FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource Era.Stone.InscriptionText}"
                                                           Opacity="{Binding Used, Converter={StaticResource BoolToOpacityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <controls:CaesarWheel Grid.Column="1" Shift="{Binding CaesarShift}" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- ============ Cipher text-demo ============ -->
                        <Border Margin="0,4,0,24" Padding="18" CornerRadius="10" Background="{DynamicResource Era.ActiveRow}"
                                Visibility="{Binding ShowGenericCipherDemo, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Try it yourself" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Era.Ink}"/>
                                <TextBlock Text="{Binding DemoInputLabel, Mode=OneWay}" Foreground="{DynamicResource Era.Muted}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding DemoInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="./Resources/Fonts/#IBM Plex Mono"
                                         Padding="10,8" Background="{DynamicResource Era.Background}" Foreground="{DynamicResource Era.Ink}" BorderThickness="1"
                                         BorderBrush="{DynamicResource Era.Line}"/>

                                <StackPanel Visibility="{Binding HasDemoKey, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DemoKeyLabel, Mode=OneWay}" Foreground="{DynamicResource Era.Muted}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding DemoKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="./Resources/Fonts/#IBM Plex Mono"
                                             Padding="10,8" Background="{DynamicResource Era.Background}" Foreground="{DynamicResource Era.Ink}" BorderThickness="1"
                                             BorderBrush="{DynamicResource Era.Line}"/>
                                </StackPanel>

                                <TextBlock Text="Result" Foreground="{DynamicResource Era.Muted}" FontWeight="Bold" Margin="0,14,0,4"/>
                                <Border Background="{DynamicResource Era.Background}" BorderBrush="{DynamicResource Era.Line}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <TextBox Text="{Binding DemoOutput, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="13" TextWrapping="Wrap"
                                             Foreground="{DynamicResource Era.Accent}" AcceptsReturn="True"/>
                                </Border>

                                <TextBlock Text="{Binding DemoExplain, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Era.Muted}" FontFamily="./Resources/Fonts/#IBM Plex Sans"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ Frequency chart demo ============ -->
                        <Border Margin="0,4,0,24" Padding="18" CornerRadius="10" Background="{DynamicResource Era.ActiveRow}"
                                Visibility="{Binding HasFrequency, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Try it yourself" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Era.Ink}"/>
                                <TextBlock Text="{Binding DemoInputLabel, Mode=OneWay}" Foreground="{DynamicResource Era.Muted}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding DemoInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="./Resources/Fonts/#IBM Plex Mono"
                                         Padding="10,8" Background="{DynamicResource Era.Background}" Foreground="{DynamicResource Era.Ink}" BorderThickness="1"
                                         BorderBrush="{DynamicResource Era.Line}" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/>

                                <TextBlock Text="Letter frequency" Foreground="{DynamicResource Era.Muted}" FontWeight="Bold" Margin="0,14,0,8"/>
                                <ItemsControl ItemsSource="{Binding FrequencyBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Letter}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Era.Ink}"/>
                                                <Border Grid.Column="1" Height="10" HorizontalAlignment="Left" CornerRadius="2"
                                                        Background="{DynamicResource Era.Accent}" Width="{Binding Fraction, Converter={StaticResource FractionToWidthConverter}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource Era.Muted}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding FrequencyExplain, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Era.Muted}" FontFamily="./Resources/Fonts/#IBM Plex Sans"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ Lesson 18: Diffie-Hellman diagram ============ -->
                        <StackPanel Visibility="{Binding IsDhLesson, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Alice -->
                                <Border Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource Era.Line}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="ALICE" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Era.Ink}" Margin="0,0,0,10"/>
                                        <TextBlock Text="SECRET (private)" FontSize="10" Foreground="{DynamicResource Era.Muted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                            <Button Content="-" Width="28" Height="28" Style="{StaticResource Frame.Button.Secondary}" Padding="0"
                                                    Command="{Binding AdjustDhSecretCommand}" CommandParameter="a-"/>
                                            <TextBlock Text="{Binding DhSecretA}" FontWeight="Bold" FontSize="20" Width="50" TextAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Era.Accent}"/>
                                            <Button Content="+" Width="28" Height="28" Style="{StaticResource Frame.Button.Secondary}" Padding="0"
                                                    Command="{Binding AdjustDhSecretCommand}" CommandParameter="a+"/>
                                        </StackPanel>
                                        <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="12" Foreground="{DynamicResource Era.Muted}" TextWrapping="Wrap">
                                            <Run Text="sends 5^"/><Run Text="{Binding DhSecretA}"/><Run Text=" mod 23 = "/><Run Text="{Binding DhAlicePublic, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Era.Ink}"/>
                                        </TextBlock>
                                        <Border Background="{DynamicResource Era.Accent}" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                                            <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Era.PrimaryButton.Fg}" TextWrapping="Wrap">
                                                <Run Text="shared = "/><Run Text="{Binding DhBobPublic, Mode=OneWay}"/><Run Text="^"/><Run Text="{Binding DhSecretA}"/><Run Text=" mod 23 = "/><Run Text="{Binding DhShared, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Channel -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="PUBLIC CHANNEL" FontSize="9" Foreground="{DynamicResource Era.Faint}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="12" Foreground="{DynamicResource Era.Muted}" HorizontalAlignment="Center">
                                        <Run Text="A "/><Run Text="&#8594;"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="12" Foreground="{DynamicResource Era.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Run Text="&#8592; B"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Bob -->
                                <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource Era.Line}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="BOB" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Era.Ink}" Margin="0,0,0,10"/>
                                        <TextBlock Text="SECRET (private)" FontSize="10" Foreground="{DynamicResource Era.Muted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                            <Button Content="-" Width="28" Height="28" Style="{StaticResource Frame.Button.Secondary}" Padding="0"
                                                    Command="{Binding AdjustDhSecretCommand}" CommandParameter="b-"/>
                                            <TextBlock Text="{Binding DhSecretB}" FontWeight="Bold" FontSize="20" Width="50" TextAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Era.Accent}"/>
                                            <Button Content="+" Width="28" Height="28" Style="{StaticResource Frame.Button.Secondary}" Padding="0"
                                                    Command="{Binding AdjustDhSecretCommand}" CommandParameter="b+"/>
                                        </StackPanel>
                                        <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="12" Foreground="{DynamicResource Era.Muted}" TextWrapping="Wrap">
                                            <Run Text="sends 5^"/><Run Text="{Binding DhSecretB}"/><Run Text=" mod 23 = "/><Run Text="{Binding DhBobPublic, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Era.Ink}"/>
                                        </TextBlock>
                                        <Border Background="{DynamicResource Era.Accent}" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                                            <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Era.PrimaryButton.Fg}" TextWrapping="Wrap">
                                                <Run Text="shared = "/><Run Text="{Binding DhAlicePublic, Mode=OneWay}"/><Run Text="^"/><Run Text="{Binding DhSecretB}"/><Run Text=" mod 23 = "/><Run Text="{Binding DhShared, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Eve -->
                            <Border Margin="0,18,0,0" Padding="14" BorderThickness="1.5" BorderBrush="{DynamicResource Era.Faint}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="12" Foreground="{DynamicResource Era.Muted}" TextWrapping="Wrap">
                                        <Run Text="EVE: " FontWeight="Bold"/>
                                        <Run Text="sees p=23, g=5, and Alice's public value "/><Run Text="{Binding DhAlicePublic, Mode=OneWay}"/>
                                        <Run Text=". Tries secret=1,2,3,... until 5^secret mod 23 matches."/>
                                    </TextBlock>
                                    <TextBlock FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Era.Accent}" Margin="0,6,0,0">
                                        <Run Text="Found secret="/><Run Text="{Binding DhEveSecret, Mode=OneWay}"/><Run Text=" in "/><Run Text="{Binding DhEveTries, Mode=OneWay}"/><Run Text=" tries"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Era.Faint}">
                                <Run Text="NOTE: with p this small Eve wins instantly. Real p is 2048+ bits, so the same search would never finish."/>
                            </TextBlock>
                        </StackPanel>

                        <!-- ============ Lesson 14: salting floppy disks ============ -->
                        <StackPanel Visibility="{Binding IsSaltingLesson, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,24">
                            <Border Background="{DynamicResource Era.PanelRaised}" CornerRadius="10" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource Era.Line}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SHARED PASSWORD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.Faint}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding DemoInput, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                                             FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Era.Ink}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="New salts" Style="{StaticResource Frame.Button.Primary}" Command="{Binding NewSaltsCommand}"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="16" CornerRadius="10" Background="{DynamicResource Era.ActiveRow}">
                                    <StackPanel>
                                        <TextBlock Text="WITHOUT SALT &#183; SHA-256(password)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.Faint}" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <controls:FloppyDisk PersonName="alice" SaltText="no salt" HashText="{Binding SaltingHashUnsalted}"
                                                                  BodyBrush="#3A3D42" LabelBrush="#FBF8EE" PenBrush="#1D3F75" Margin="0,0,10,0"/>
                                            <controls:FloppyDisk PersonName="bob" SaltText="no salt" HashText="{Binding SaltingHashUnsalted}"
                                                                  BodyBrush="#3A3D42" LabelBrush="#FBF8EE" PenBrush="#1D3F75"/>
                                        </StackPanel>
                                        <TextBlock Text="Identical disks. Crack one, you've cracked both." Foreground="{DynamicResource Era.Dialup.Leak}" FontWeight="SemiBold"
                                                   FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="16" CornerRadius="10" Background="{DynamicResource Era.ActiveRow}">
                                    <StackPanel>
                                        <TextBlock Text="WITH SALT &#183; SHA-256(salt + password)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.AccentText}" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <controls:FloppyDisk PersonName="alice" SaltText="{Binding SaltingSaltAHex, StringFormat='salt {0}'}" HashText="{Binding SaltingHashA}"
                                                                  BodyBrush="#2F6FB5" LabelBrush="#FBF8EE" PenBrush="#1D3F75" Margin="0,0,10,0"/>
                                            <controls:FloppyDisk PersonName="bob" SaltText="{Binding SaltingSaltBHex, StringFormat='salt {0}'}" HashText="{Binding SaltingHashB}"
                                                                  BodyBrush="#E2A31F" LabelBrush="#FBF8EE" PenBrush="#1D3F75"/>
                                        </StackPanel>
                                        <TextBlock Text="Different disks, same password. Each one has to be cracked separately." Foreground="{DynamicResource Era.AccentText}" FontWeight="SemiBold"
                                                   FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ============ Lesson 11: ECB/CBC punch cards ============ -->
                        <StackPanel Visibility="{Binding IsEcbCbcLesson, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,24">
                            <Border Height="10" CornerRadius="2" Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D2561C" Offset="0"/>
                                        <GradientStop Color="#D2561C" Offset=".25"/>
                                        <GradientStop Color="#E8932C" Offset=".25"/>
                                        <GradientStop Color="#E8932C" Offset=".5"/>
                                        <GradientStop Color="#E8B84A" Offset=".5"/>
                                        <GradientStop Color="#E8B84A" Offset=".75"/>
                                        <GradientStop Color="#6B3D1F" Offset=".75"/>
                                        <GradientStop Color="#6B3D1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Background="{DynamicResource Era.PanelRaised}" CornerRadius="10" Padding="14,10" BorderThickness="1.5" BorderBrush="{DynamicResource Era.Line}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="INPUT DECK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.Faint}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding DemoInput, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                                             FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Era.Ink}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="{DynamicResource Era.Machine.Leak}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Foreground="#F8EFD8" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="SemiBold" FontSize="12">
                                            <Run Text="{Binding InputByteCount, Mode=OneWay}"/><Run Text=" BYTES &#183; AES-128"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="ECB OUTPUT CARDS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.Faint}" Margin="10,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="CBC OUTPUT CARDS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Era.Faint}" Margin="10,0,0,8"/>

                                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding EcbCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8" Height="84">
                                                <TextBlock Text="{Binding BlockNumber, StringFormat='B{0}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Era.Ink}"/>
                                                <Border Background="{DynamicResource Era.Machine.PunchCard}" CornerRadius="0" Padding="6,4" Margin="0,4,8,0">
                                                    <TextBlock Text="{Binding PlaintextFragment}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Era.Ink}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding EcbCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8" Height="84">
                                                <Border CornerRadius="0,14,0,0" Padding="10,8" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Era.Machine.PunchCard}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Era.Line}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RepeatOfBlock, Converter={StaticResource NotNullConverter}}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Era.Machine.PunchCardRepeat}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Era.Machine.Leak}"/>
                                                                    <Setter Property="BorderThickness" Value="3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding HexGrouped}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Era.Ink}"/>
                                                </Border>
                                                <Border Background="{DynamicResource Era.Machine.Leak}" CornerRadius="3" Padding="6,2" BorderThickness="2" BorderBrush="{DynamicResource Era.Machine.Leak}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,6,0"
                                                        Visibility="{Binding RepeatOfBlock, Converter={StaticResource NotNullToVisibilityConverter}}">
                                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="10" RenderTransformOrigin=".5,.5">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform Angle="-6"/>
                                                        </TextBlock.RenderTransform>
                                                        <Run Text="SAME = B"/><Run Text="{Binding RepeatOfBlock}"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding CbcCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0,14,0,0" Padding="10,8" Margin="0,0,0,8" Height="84"
                                                    Background="{DynamicResource Era.Machine.PunchCard}" BorderThickness="1" BorderBrush="{DynamicResource Era.Line}">
                                                <TextBlock Text="{Binding HexGrouped}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Era.Ink}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Era.Muted}" FontSize="13">
                                <Run Text="Identical cards in the ECB stack: "/>
                                <Run Text="{Binding EcbRepeatCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Era.Machine.Leak}"/>
                                <Run Text=". In the CBC stack: 0."/>
                            </TextBlock>
                        </StackPanel>

                        <!-- ============ Block-pattern (ECB vs CBC) demo ============ -->
                        <Border Margin="0,4,0,24" Padding="18" CornerRadius="10" Background="{DynamicResource Era.ActiveRow}"
                                Visibility="{Binding ShowGenericBlockPattern, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Try it yourself" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Era.Ink}"/>
                                <TextBlock Text="{Binding DemoInputLabel, Mode=OneWay}" Foreground="{DynamicResource Era.Muted}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding DemoInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="./Resources/Fonts/#IBM Plex Mono"
                                         Padding="10,8" Background="{DynamicResource Era.Background}" Foreground="{DynamicResource Era.Ink}" BorderThickness="1"
                                         BorderBrush="{DynamicResource Era.Line}"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ECB — each block independent" Foreground="{DynamicResource Era.Muted}" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding EcbBlocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Era.Background}" BorderBrush="{DynamicResource Era.Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4" Padding="8,5">
                                                        <TextBlock Text="{Binding}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="11" Foreground="{DynamicResource Era.Accent}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CBC — chained to the block before it" Foreground="{DynamicResource Era.Muted}" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding CbcBlocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Era.Background}" BorderBrush="{DynamicResource Era.Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4" Padding="8,5">
                                                        <TextBlock Text="{Binding}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="11" Foreground="{DynamicResource Era.Accent}" TextWrapping="Wrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding BlockPatternExplain, Mode=OneWay}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Era.Muted}" FontFamily="./Resources/Fonts/#IBM Plex Sans"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= FOOTER ================= -->
            <Grid Grid.Row="2" Margin="36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="{Binding BackButtonLabel}" Style="{StaticResource Frame.Button.Secondary}"
                        Margin="0,0,10,0" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"/>
                <TextBlock Grid.Column="1" Text="Review any lesson" VerticalAlignment="Center" Margin="0,0,180,0" FontSize="12"
                           Foreground="{DynamicResource Era.Faint}" Visibility="{Binding IsWrapUp, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Grid.Column="2" Content="{Binding NextButtonLabel, Mode=OneWay}" Style="{StaticResource Frame.Button.Primary}"
                        Command="{Binding NextCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
