<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Part II · Raw bits · The Machine Age (1970s computer room, punch cards). Values from themes.json. -->

    <SolidColorBrush x:Key="Era.Background" Color="#F1E6CC"/>
    <SolidColorBrush x:Key="Era.SidebarBrush" Color="#E7D7B3"/>
    <SolidColorBrush x:Key="Era.Ink" Color="#2E1F12"/>
    <SolidColorBrush x:Key="Era.Muted" Color="#6B5238"/>
    <SolidColorBrush x:Key="Era.Faint" Color="#9A8466"/>
    <SolidColorBrush x:Key="Era.Accent" Color="#D2561C"/>
    <SolidColorBrush x:Key="Era.AccentText" Color="#A8400F"/>
    <SolidColorBrush x:Key="Era.Line" Color="#332E1F12"/>
    <SolidColorBrush x:Key="Era.ActiveRow" Color="#24D2561C"/>

    <SolidColorBrush x:Key="Era.PrimaryButton.Bg" Color="#D2561C"/>
    <SolidColorBrush x:Key="Era.PrimaryButton.Fg" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="Era.SecondaryButton.Bg" Color="Transparent"/>
    <SolidColorBrush x:Key="Era.SecondaryButton.Fg" Color="#2E1F12"/>
    <SolidColorBrush x:Key="Era.SecondaryButton.Border" Color="#662E1F12"/>

    <FontFamily x:Key="Era.DisplayFont">./Resources/Fonts/#Bricolage Grotesque</FontFamily>
    <FontFamily x:Key="Era.DataFont">./Resources/Fonts/#IBM Plex Mono</FontFamily>

    <BitmapImage x:Key="Era.Mascot" UriSource="pack://application:,,,/Resources/Mascots/minion-raw-bits.png"/>
    <BitmapImage x:Key="Era.Icon" UriSource="pack://application:,,,/Resources/Mascots/minion-raw-bits.png"/>

    <!-- Punch-card extras, used only by the Part II sample lesson and divider. -->
    <SolidColorBrush x:Key="Era.Machine.TopStripe1" Color="#D2561C"/>
    <SolidColorBrush x:Key="Era.Machine.TopStripe2" Color="#E8932C"/>
    <SolidColorBrush x:Key="Era.Machine.TopStripe3" Color="#E8B84A"/>
    <SolidColorBrush x:Key="Era.Machine.TopStripe4" Color="#6B3D1F"/>
    <SolidColorBrush x:Key="Era.Machine.PunchCard" Color="#F3E2A9"/>
    <SolidColorBrush x:Key="Era.Machine.PunchCardRepeat" Color="#F5B88A"/>
    <SolidColorBrush x:Key="Era.Machine.Leak" Color="#B3260F"/>

</ResourceDictionary>
