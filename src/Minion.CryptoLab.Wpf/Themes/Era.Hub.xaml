<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral charcoal hub: Home and the Wrap-up screen. Values from the design handoff's themes.json. -->

    <SolidColorBrush x:Key="Era.Background" Color="#18171C"/>
    <SolidColorBrush x:Key="Era.SidebarBrush" Color="#13121B"/>
    <SolidColorBrush x:Key="Era.Panel" Color="#211F27"/>
    <SolidColorBrush x:Key="Era.PanelRaised" Color="#2C2A33"/>
    <SolidColorBrush x:Key="Era.Ink" Color="#F1EEE8"/>
    <SolidColorBrush x:Key="Era.Muted" Color="#A9A4B3"/>
    <SolidColorBrush x:Key="Era.Faint" Color="#6C6777"/>
    <SolidColorBrush x:Key="Era.Accent" Color="#FF4FA3"/>
    <SolidColorBrush x:Key="Era.AccentText" Color="#FF4FA3"/>
    <SolidColorBrush x:Key="Era.Line" Color="#2C2A33"/>
    <SolidColorBrush x:Key="Era.ActiveRow" Color="#2C2A33"/>

    <SolidColorBrush x:Key="Era.PrimaryButton.Bg" Color="#FF4FA3"/>
    <SolidColorBrush x:Key="Era.PrimaryButton.Fg" Color="#18171C"/>
    <SolidColorBrush x:Key="Era.SecondaryButton.Bg" Color="Transparent"/>
    <SolidColorBrush x:Key="Era.SecondaryButton.Fg" Color="#F1EEE8"/>
    <SolidColorBrush x:Key="Era.SecondaryButton.Border" Color="#2C2A33"/>

    <FontFamily x:Key="Era.DisplayFont">./Resources/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Era.DataFont">./Resources/Fonts/#IBM Plex Mono</FontFamily>

</ResourceDictionary>
