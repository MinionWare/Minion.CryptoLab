<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- "One frame, four skins": every style here reads only Era.* DynamicResource keys, so
         swapping the merged Era.*.xaml dictionary (ThemeService.Apply) re-skins the whole shell. -->

    <!-- Progress-bar segment / wrap-up recap colours: fixed per part regardless of the active era,
         so these live here (always merged) rather than in a swappable Era.*.xaml file. -->
    <SolidColorBrush x:Key="Era.Progress.I" Color="#A3402C"/>
    <SolidColorBrush x:Key="Era.Progress.II" Color="#D2561C"/>
    <SolidColorBrush x:Key="Era.Progress.III" Color="#2F6FB5"/>
    <SolidColorBrush x:Key="Era.Progress.IV" Color="#8FB0FF"/>
    <SolidColorBrush x:Key="Era.Progress.Wrap" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Era.Recap.I" Color="#D0573E"/>
    <SolidColorBrush x:Key="Era.Recap.II" Color="#E8743A"/>
    <SolidColorBrush x:Key="Era.Recap.III" Color="#4F8FE0"/>
    <SolidColorBrush x:Key="Era.Recap.IV" Color="#9DB8FF"/>

    <Style x:Key="Frame.SidebarLogo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.Ink}"/>
    </Style>

    <Style x:Key="Frame.SidebarPartHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.AccentText}"/>
    </Style>

    <Style x:Key="Frame.SidebarPartHeaderCollapsed" TargetType="TextBlock" BasedOn="{StaticResource Frame.SidebarPartHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Era.Faint}"/>
    </Style>

    <Style x:Key="Frame.SidebarLessonTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.Muted}"/>
    </Style>

    <Style x:Key="Frame.SidebarLessonNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Mono"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.Faint}"/>
    </Style>

    <!-- A lesson row: active-state swap handled by the active-specific styles below, chosen in
         the XAML via a DataTrigger on IsCurrent rather than here, since WPF styles can't easily
         branch child-element foregrounds from one shared style without a template. -->
    <Style x:Key="Frame.SidebarRow" TargetType="Border">
        <Setter Property="Padding" Value="22,7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Frame.SidebarRow.Active" TargetType="Border" BasedOn="{StaticResource Frame.SidebarRow}">
        <Setter Property="Background" Value="{DynamicResource Era.ActiveRow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Era.Accent}"/>
    </Style>

    <Style x:Key="Frame.HeaderPartLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.AccentText}"/>
    </Style>

    <Style x:Key="Frame.HeaderStepLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.Muted}"/>
    </Style>

    <Style x:Key="Frame.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Era.PrimaryButton.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.PrimaryButton.Fg}"/>
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Frame.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Era.SecondaryButton.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Era.SecondaryButton.Fg}"/>
        <Setter Property="FontFamily" Value="./Resources/Fonts/#IBM Plex Sans"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Era.SecondaryButton.Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
