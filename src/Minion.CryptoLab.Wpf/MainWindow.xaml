<Window x:Class="Minion.CryptoLab.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minion.CryptoLab.Wpf"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="Minion.CryptoLab" Height="760" Width="1100" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= MENU BAR ================= -->
        <Menu Grid.Row="0" Background="{DynamicResource Brush.Bg1}" Foreground="{DynamicResource Brush.TextPrimary}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Show tutorial" Click="TutorialButton_Click"/>
            </MenuItem>
        </Menu>

        <!-- ================= UPDATE BANNER =================
             Collapsed until MainWindow.xaml.cs's startup update check finds a newer,
             non-skipped version. See CheckForUpdatesAsync. -->
        <Border x:Name="UpdateBanner" Grid.Row="1"
                Background="{DynamicResource Brush.AccentMuted}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,1"
                Visibility="Collapsed" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateBannerText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="UpdateBannerWhatsNewButton" Grid.Column="1" Content="What's New" Style="{StaticResource Button.Ghost}"
                        Click="UpdateBannerWhatsNew_Click" Margin="8,0,0,0"/>
                <Button x:Name="UpdateBannerDownloadButton" Grid.Column="2" Content="Download" Style="{StaticResource Button.Primary}"
                        Click="UpdateBannerDownload_Click" Margin="8,0,0,0"/>
                <Button x:Name="UpdateBannerDismissButton" Grid.Column="3" Content="✕" Style="{StaticResource Button.Ghost}"
                        Click="UpdateBannerDismiss_Click" Margin="8,0,0,0" ToolTip="Dismiss — won't ask again for this version"/>
            </Grid>
        </Border>

        <!-- ================= HOME ================= -->
        <Grid Grid.Row="2" Background="{DynamicResource Era.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CryptoLab" VerticalAlignment="Center" FontFamily="./Resources/Fonts/#IBM Plex Sans"
                           FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource Era.Ink}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource Era.Muted}" FontSize="13">
                    <Run Text="{Binding CompletedLessonCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalLessonCount, Mode=OneWay}"/><Run Text=" lessons"/>
                </TextBlock>
                <Button Grid.Column="3" Content="{Binding ContinueLabel}" Style="{StaticResource Frame.Button.Primary}" Click="ContinueButton_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,20,36,36">
                    <TextBlock Text="Two thousand years of secret-keeping." FontFamily="{DynamicResource Era.DisplayFont}"
                               FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Era.Ink}" TextWrapping="Wrap"/>
                    <TextBlock Text="Four eras, 26 lessons, and real cryptography in every demo. Pick an era to see its lessons."
                               Foreground="{DynamicResource Era.Muted}" FontSize="14" Margin="0,8,0,24" TextWrapping="Wrap"/>

                    <!-- Era tiles: each uses PartTileBrushConverter/PartToMascotConverter since all four
                         eras' colours must show at once here, unlike every other screen. -->
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,46,10,0" Padding="18,16" CornerRadius="16" Height="354" VerticalAlignment="Top" Cursor="Hand"
                                        Background="{Binding Part, Converter={StaticResource PartTileBrushConverter}, ConverterParameter=Background}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding Part, Converter={StaticResource PartToMascotConverter}}"
                                               Width="140" Height="140" Margin="0,-62,0,0" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                            <TextBlock Text="{Binding Info.Roman, StringFormat='PART {0}'}" FontFamily="./Resources/Fonts/#IBM Plex Sans"
                                                       FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{Binding Part, Converter={StaticResource PartTileBrushConverter}, ConverterParameter=Accent}"/>
                                            <TextBlock Text="{Binding Info.Title}" FontFamily="./Resources/Fonts/#Bricolage Grotesque"
                                                       FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,2,0,6"
                                                       Foreground="{Binding Part, Converter={StaticResource PartTileBrushConverter}, ConverterParameter=Ink}"/>
                                            <TextBlock FontSize="12" Margin="0,0,0,8" Foreground="{Binding Part, Converter={StaticResource PartTileBrushConverter}, ConverterParameter=Muted}">
                                                <Run Text="{Binding Info.Era, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Info.DateRange, Mode=OneWay}"/>
                                            </TextBlock>
                                            <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                                         Foreground="{Binding Part, Converter={StaticResource PartTileBrushConverter}, ConverterParameter=Accent}"
                                                         Background="#22000000" BorderThickness="0" Margin="0,8,0,8"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding Part, Converter={StaticResource PartTileBrushConverter}, ConverterParameter=Accent}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Selected-era panel -->
                    <Border Margin="0,24,0,0" Padding="20" CornerRadius="14" Background="{DynamicResource Era.Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedPartSummary}" Foreground="{DynamicResource Era.Ink}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding SelectedPartLessons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="999" Cursor="Hand"
                                                    Background="{DynamicResource Era.PanelRaised}" BorderThickness="1" BorderBrush="{DynamicResource Era.Line}"
                                                    MouseLeftButtonUp="LessonPill_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Number}" FontFamily="./Resources/Fonts/#IBM Plex Mono" FontSize="11" Foreground="{DynamicResource Era.Faint}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Era.Muted}"/>
                                                    <TextBlock Text=" ✓" FontSize="12" Foreground="{DynamicResource Era.Accent}" FontWeight="Bold"
                                                               Visibility="{Binding Done, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="{Binding CtaLabel}" Style="{StaticResource Frame.Button.Primary}" Click="TileCta_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
